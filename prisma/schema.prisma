generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enums
enum Gender {
  MALE
  FEMALE
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

// Models
model Cart {
  id          Int     @id @default(autoincrement())
  totalAmount Int

  userId String  @unique

  items CartItem[]

  @@map("carts")
}

model CartItem {
  id         Int     @id @default(autoincrement())
  quantity   Int
  unitPrice  Decimal @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(10, 2)

  cartId Int
  cart   Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  @@map("cart_items")
}

model Category {
  id     Int     @id @default(autoincrement())
  name   String
  gender Gender?

  products Product[]

  @@map("categories")
}

model Product {
  id          Int     @id @default(autoincrement())
  name        String
  brand       String?
  price       Decimal @db.Decimal(10, 2)
  inventory   Int
  description String?

  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id])

  images     String[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@map("products")
}

model Order {
  id          Int         @id @default(autoincrement()) @map("orderId")
  orderDate   DateTime    @db.Date
  totalAmount Int
  orderStatus OrderStatus

  userId String

  orderItems OrderItem[]

  @@map("orders")
}

model OrderItem {
  id       Int     @id @default(autoincrement())
  quantity Int
  price    Decimal @db.Decimal(10, 2)

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}
